---
import { getCollection } from "astro:content";
import { Image, getImage } from "astro:assets";
import { siteConfig } from "../../config";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Nav from "../../components/Nav.vue";
import GiftForm from "../../components/GiftForm.vue";
import Footer from "../../components/Footer.astro";
import logo from "../../assets/logo.png";

export async function getStaticPaths() {
  const gifts = await getCollection("gifts");
  return gifts.map((gift) => ({
    params: { slug: gift.id },
    props: { gift },
  }));
}

const { gift } = Astro.props;
const d = gift.data;

const apiUrl = siteConfig.gifts.apiUrl;
const apiKey = siteConfig.gifts.apiKey;
const fileUrl = new URL(d.file, Astro.url.origin).href;
const fileName = d.file.split("/").pop() ?? d.file;
const logoOptimized = await getImage({ src: logo, format: "webp" });
---

<BaseLayout
  title={`${d.title} — L'atelier Psy`}
  description={d.description}
  noindex={true}
>
  <Nav
    client:load
    logoSrc={logoOptimized.src}
    navLinks={siteConfig.nav.links}
    navActions={siteConfig.nav.actions}
  />

  <main
    class="relative overflow-hidden bg-gradient-to-b from-surface to-white pt-28 pb-20"
  >
    <div
      class="absolute inset-0 dot-pattern opacity-40 pointer-events-none"
      aria-hidden="true"
    >
    </div>
    <div class="relative max-w-5xl mx-auto px-4 sm:px-6">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
        <div class="reveal">
          <div
            class="inline-flex items-center gap-2 text-xs font-semibold tracking-wide uppercase text-brand bg-brand/10 px-3 py-1.5 rounded-full mb-5"
          >
            🎁 Téléchargement gratuit
          </div>
          <h1
            class="font-pronell text-4xl md:text-5xl text-ink leading-tight mb-5"
          >
            {d.title}
          </h1>
          <p class="text-lg text-ink-light leading-relaxed mb-8">
            {d.description}
          </p>
          <div
            class="bg-white rounded-2xl border border-border shadow-xl shadow-ink/5 p-6 md:p-8"
          >
            <GiftForm
              client:load
              giftTitle={d.titleFile ?? d.title}
              fileUrl={fileUrl}
              fileName={fileName}
              apiUrl={apiUrl}
              apiKey={apiKey}
            />
          </div>
        </div>
        <div class="reveal reveal-d2 relative">
          <div
            class="absolute -inset-6 bg-brand/20 rounded-[2.5rem] blur-3xl pointer-events-none"
            aria-hidden="true"
          >
          </div>
          <div
            class="relative rounded-2xl overflow-hidden shadow-2xl shadow-ink/20"
          >
            <Image
              src={d.image}
              alt={d.title}
              format="webp"
              class="w-full h-auto"
              loading="eager"
            />
          </div>
        </div>
      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>
